{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run game (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Run smoke test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/smoke_test.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Regenerate assets",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/make_assets.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
